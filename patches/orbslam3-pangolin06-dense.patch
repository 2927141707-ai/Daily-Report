+
+bool System::GetCurrentDenseKeyFrame(DenseKeyFrame& out)
+{
+    KeyFrame* k = mpTracker->GetLastKeyFrame();
+    if(!k || k->mTimeStamp != mpTracker->mCurrentFrame.mTimeStamp) return false;
+    out = {k->mnId, k->mnFrameId, k->mTimeStamp, k->GetPoseInverse()};
+    return true;
+}
+
+System::DenseSnapshot System::GetDenseSnapshot()
+{
+    // Map/KeyFrame destruction on Reset is serialized by the calling owner
+    // thread. No SLAM pointer escapes this method. Do not hold Atlas lock while
+    // acquiring map-update locks: Tracking/LoopClosing take the opposite order.
+    DenseSnapshot out;
+    out.active_map = mpAtlas->GetCurrentMap()->GetId();
+    const auto maps = mpAtlas->GetAllMaps();
+    for(Map* map : maps) {
+        std::unique_lock<std::mutex> lock(map->mMutexMapUpdate);
+        if(map->IsBad()) continue;
+        DenseMap dm{map->GetId(), map->GetMapChangeIndex(), {}};
+        for(KeyFrame* k : map->GetAllKeyFrames()) {
+            if(k->isBad() || k->GetMap()!=map) continue;
+            dm.keyframes.push_back({k->mnId,k->mnFrameId,k->mTimeStamp,k->GetPoseInverse()});
+        }
+        std::sort(dm.keyframes.begin(),dm.keyframes.end(),
+                  [](const DenseKeyFrame& a,const DenseKeyFrame& b){return a.timestamp<b.timestamp;});
+        out.maps.push_back(std::move(dm));
+    }
+    // A merge may have changed the atlas while copying a different map. Reject
+    // such a snapshot instead of publishing duplicate/inconsistent memberships.
+    const auto after = mpAtlas->GetAllMaps();
+    if(maps!=after || out.active_map!=mpAtlas->GetCurrentMap()->GetId())
+        throw std::runtime_error("Dense snapshot deferred: atlas membership changed");
+    std::set<unsigned long> seen;
+    for(const auto& map : out.maps) for(const auto& k : map.keyframes)
+        if(!seen.insert(k.id).second)
+            throw std::runtime_error("Dense snapshot deferred: keyframe moved between maps");
+    return out;
 }
 
